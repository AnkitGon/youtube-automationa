# ── Agent Language ────────────────────────────────────────────────────────────
# Language your Telegram assistant speaks: english | italian
AGENT_LANGUAGE=english

# ── AI Service ────────────────────────────────────────────────────────────────
# Primary text generation (topic, script, strategy).
# Options: openrouter | openai | anthropic | gemini | mistral | groq | deepseek
#          xai | cohere | together | perplexity | fireworks | azure_openai
#          ollama_cloud | ollama_local
AI_SERVICE=openrouter

# ── OpenRouter (free tier) — https://openrouter.ai/keys ─────────────────────
OPENROUTER_API_KEY=
# Primary free model; on 429/404 rotates through OPENROUTER_FALLBACK_MODELS + built-in pool
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_USE_FREE_MODEL_POOL=1
OPENROUTER_ROTATE_ON_429=1
OPENROUTER_FALLBACK_RETRY_WAIT_SEC=30

# ── Groq fallback (free tier, fast) — https://console.groq.com/keys ─────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# ── Gemini fallback (free tier) — https://aistudio.google.com/apikey ────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-lite

# OpenRouter 429 backoff: wait = OPENROUTER_RATE_LIMIT_WAIT_SEC × attempt (default 15,30,45,60)
OPENROUTER_RATE_LIMIT_WAIT_SEC=15
OPENROUTER_MAX_ATTEMPTS=4

# When primary AI_SERVICE fails (429, outage), try these in order (comma-separated).
# Default: openrouter only (uses OPENROUTER_FALLBACK_MODELS). Add ollama_local if Ollama runs locally.
AI_FALLBACK_SERVICES=openrouter

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# xAI (Grok) — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-2-1212

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024

# Together AI — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Perplexity AI — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online

# Fireworks AI — https://fireworks.ai/api-keys
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Azure OpenAI — https://portal.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Ollama Cloud — https://ollama.com
OLLAMA_API_KEY=

# Ollama Local (no key needed)
OLLAMA_LOCAL_MODEL=llama3.2

PEXELS_API_KEY=your_pexels_key_here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Thumbnail image generation ────────────────────────────────────────────────
# Provider for the AI background image: pollinations | huggingface | openrouter
# Fallback chain runs the others automatically; final fallback is a local gradient.
IMAGE_PROVIDER=pollinations
# HuggingFace token (FLUX.1-schnell) — https://huggingface.co/settings/tokens
HF_API_KEY=
# Pollinations free token (lifts anonymous queue limit) — https://enter.pollinations.ai
POLLINATIONS_TOKEN=

# ── Publish scheduling (audience timezone — NOT PC local time) ───────────────
# Default publish slot when analytics has insufficient viewer-activity data
DEFAULT_PUBLISH_TIME=18:00
DEFAULT_PUBLISH_TIMEZONE=Asia/Kolkata
# Comma-separated weekday names or 0-6 (Mon=0) — empty = any day
# DEFAULT_PUBLISH_DAYS=Saturday,Sunday
ANALYTICS_MIN_VIDEOS_FOR_SCHEDULING=3
ANALYTICS_ROLLING_VIDEOS=10
SCHEDULER_LEAD_MINUTES=0
SCHEDULER_ACTIVITY_MIN_VIEWS=50
SCHEDULER_ACTIVITY_MIN_BUCKETS=4
# When the pipeline runs (UTC) — auto-derived from DEFAULT_PUBLISH_TIME minus PRODUCTION_LEAD_HOURS
PRODUCTION_LEAD_HOURS=3
AUTO_DERIVE_PIPELINE_TRIGGER=1
# If today's publish slot already passed, schedule same day after this lead (not tomorrow)
SCHEDULER_SAME_DAY_PUBLISH=1
SCHEDULER_SAME_DAY_MIN_LEAD_MINUTES=30
# Legacy fixed UTC trigger — only when AUTO_DERIVE_PIPELINE_TRIGGER=0
PIPELINE_TRIGGER_HOURS=14
# Legacy: only used when auto_scheduling=off and manual publish hours set
TRIGGER_LEAD_HOURS=3

# FFmpeg path override (leave empty to use system PATH)
FFMPEG_PATH=

# Raspberry/low-power rendering. "auto" enables lighter settings on ARM boards.
PI_SAFE_MODE=auto
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
FFMPEG_THREADS=2
X264_PRESET=ultrafast
X264_CRF=28
USE_FFMPEG_RENDER=auto

# Mostra solo poche frasi importanti pronunciate nel video.
VIDEO_CAPTIONS=1
MAX_KEY_CAPTIONS=8
CAPTION_FONT_SIZE=42
CAPTION_MIN_GAP_SECONDS=12

# Long-form daily pipeline (false = pause scheduled/forced long videos; Shorts unchanged)
LONG_FORM_ENABLED=true

# ── YouTube Shorts pipeline ───────────────────────────────────────────────────
SHORTS_ENABLED=true
SHORTS_PER_DAY=3
# Fallback local hours when audience analytics are insufficient (morning / afternoon / evening)
SHORTS_FALLBACK_HOURS=10,15,20
# Dynamic slots from YouTube "when viewers are on YouTube" (1=on, 0=static SHORTS_PRODUCTION_HOURS)
SHORTS_DYNAMIC_SCHEDULE=1
SHORTS_MIN_SLOT_GAP_HOURS=4
# Local hour ranges for each daily Short (inclusive): morning, afternoon, evening
SHORTS_PERIOD_MORNING=5,11
SHORTS_PERIOD_AFTERNOON=12,16
SHORTS_PERIOD_EVENING=17,22
# Legacy static production hours (used only when SHORTS_DYNAMIC_SCHEDULE=0)
SHORTS_PRODUCTION_HOURS=10,15,20
SHORTS_TIMEZONE=Asia/Kolkata
SHORTS_PUBLISH_LEAD_MINUTES=20
SHORTS_FALLBACK_HOURS=10,15,20
SHORTS_MIN_DURATION=20
SHORTS_MAX_DURATION=60
SHORTS_TOPIC_REUSE=true
SHORTS_SIMILARITY_THRESHOLD=0.78
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920
# 0 = auto (~86px at 1080x1920). Try 92-100 if still small on your phone.
SHORTS_CAPTION_FONT_SIZE=0
SHORTS_CAPTION_UPPERCASE=1
SHORTS_CAPTION_WORDS_PER_GROUP=3
SHORTS_SEGMENT_MIN_SECONDS=1.5
SHORTS_SEGMENT_MAX_SECONDS=4
SHORTS_ANALYTICS_MIN_VIDEOS=6
SHORTS_SKIP_QUALITY_GATE=0
# Manual /shorts now bypasses the 3/day scheduled quota (1=on, 0=block when quota full)
SHORTS_MANUAL_IGNORE_QUOTA=1
# SHORTS_TTS_VOICE=en-US-GuyNeural

# ── TTS pacing (reduce dead-air between sentences) ───────────────────────────
# Compress internal pauses longer than threshold down to max pause (seconds)
TTS_COMPRESS_PAUSES=1
TTS_MAX_PAUSE_SECONDS=0.32
TTS_COMPRESS_THRESHOLD_SECONDS=0.42
TTS_SILENCE_THRESHOLD_DB=-35
TTS_CHUNK_EDGE_TRIM=1
# Optional speech rate tweak (Edge TTS): +5% / -10% — not a substitute for good scripts
# TTS_RATE=+0%
