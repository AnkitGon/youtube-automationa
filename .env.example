# AI service: openrouter | openai | anthropic | gemini | ollama_cloud | ollama_local
AI_SERVICE=openrouter

# OpenRouter (free tier) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama Cloud — https://ollama.com
OLLAMA_API_KEY=
# Ollama Local
OLLAMA_LOCAL_MODEL=llama3.2

PEXELS_API_KEY=your_pexels_key_here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# FFmpeg path override (leave empty to use system PATH)
FFMPEG_PATH=

# Raspberry/low-power rendering. "auto" enables lighter settings on ARM boards.
PI_SAFE_MODE=auto
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
FFMPEG_THREADS=2
X264_PRESET=ultrafast
X264_CRF=28
USE_FFMPEG_RENDER=auto

# Mostra solo poche frasi importanti pronunciate nel video.
VIDEO_CAPTIONS=1
MAX_KEY_CAPTIONS=8
CAPTION_FONT_SIZE=42
CAPTION_MIN_GAP_SECONDS=12
